alert tcp any any -> $HOME_NET 21 (msg:"CUSTOM FTP Brute-Force - Rapid Connection Attempts"; flow:to_server; flags:S; threshold: type threshold, track by_src, count 3, seconds 20; classtype:attempted-recon; sid:9000001; rev:1;)

alert tcp any any -> $HOME_NET 80 (msg:"CUSTOM SYN Flood - Excessive SYN packets from single source"; flow:to_server; flags:S; threshold: type threshold, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:9000002; rev:1;)
